  forcedM: null,
  flash: 0,
  finale: false,      // 嵓ｼ���� �ｬ�� (80s~)
  finaleTime: 0,      // 嵓ｼ���� �ｽ�ｼ �懋ｰ�(��)
  earthAlpha: 0,      // ��ｬ 妤ｬ��巡
  precision: false,   // �簿ｰ�ｬ�ｩ �ｬ�� (180s~, �罷糖�ｬ�､ ��圸)
