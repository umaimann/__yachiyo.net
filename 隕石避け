const LB_ROW_Y0    = 126;
const LB_ROW_H     = 46;
const LB_TITLE_DUR = 500;
const LB_ROW_START = 650;
const LB_ROW_DT    = 120;
const BTN_LB_RETRY = { x: 50,  y: 660, w: 160, h: 44 };
const BTN_LB_MENU  = { x: 270, y: 660, w: 160, h: 44 };
let lbState = null;

function goLeaderboard(scores, playerRank, playerName) {
  lbState = {
    t: 0,
    scores, playerRank, playerName,
    playerRowIdx:   -1,
    playerRevealed: false,
    playerRevealT:  0,
    flashAlpha:     0,
    glowPulse:      0,
    btnAlpha:       0,
  };
  bubble = null; parts.length = 0;
  goState('leaderboard');
}

function _lbRows() {
  if (!lbState) return [];
  const {scores, playerRank, viewOnly} = lbState;
  if (viewOnly) return scores.slice(0, 10);
  if (playerRank <= 10) return scores.slice(0, 10);
  return [...scores.slice(0, 9), {isSep:true}, scores.find(s => s.isPlayer)];
}

function tickLeaderboard(dt) {
  if (!lbState) return;
  lbState.t += dt;
  tickParts(dt); tickStars(dt); tickLines(dt); tickBubble(dt);
  const rows = _lbRows();
  if (lbState.playerRowIdx < 0)
    lbState.playerRowIdx = rows.findIndex(r => r && r.isPlayer);
  const pIdx    = lbState.playerRowIdx;
  const revealT = pIdx >= 0 ? LB_ROW_START + pIdx * LB_ROW_DT : 99999;
  if (!lbState.playerRevealed && pIdx >= 0 && lbState.t > revealT) {
    lbState.playerRevealed = true;
    lbState.playerRevealT  = lbState.t;
    const ry = LB_ROW_Y0 + pIdx * LB_ROW_H + LB_ROW_H / 2;
    const sc = getShipColor();
    spawn(CW/2, ry, 40, {c: sc.stroke,  spd:5,   dc:0.013});
    spawn(CW/2, ry, 20, {c: '#ffffff',  spd:3,   r:1.5, dc:0.017});
    spawn(CW/2, ry, 15, {c: '#cc88ff',  spd:4,   dc:0.015});
    spawn(CW/2, ry, 12, {c: '#ffcc44',  spd:2.5, r:2,   dc:0.014});
    setTimeout(() => showBubble(getRankMsg(lbState.playerRank), 5500), 500);
  }
  if (lbState.playerRevealed) {
    const since       = lbState.t - lbState.playerRevealT;
    lbState.flashAlpha = since < 300 ? (1 - since/300) * 0.75 : 0;
    lbState.glowPulse  = (Math.sin(lbState.t * 0.005) + 1) / 2;
  }

  const lastRowT = LB_ROW_START + (_lbRows().length - 1) * LB_ROW_DT;
  const btnT = lbState.viewOnly
    ? lastRowT + 600
    : lbState.playerRevealT > 0 ? lbState.playerRevealT + 1800 : 99999;
  if (lbState.t > btnT)
    lbState.btnAlpha = Math.min(1, lbState.btnAlpha + 0.025 * (dt/8.333));
}

function _rankBadge(rank, cx, cy, t) {
  const r = rank === 1 ? 16 : rank === 2 ? 13 : rank === 3 ? 11 : rank === 10 ? 16 : 10;
  ctx.save();

  if (rank === 1 && t != null) {
    const ang = (t * 0.0014) % (Math.PI * 2);
    ctx.save(); ctx.translate(cx, cy);
    ctx.rotate(ang);
    ctx.beginPath(); ctx.arc(0, 0, r + 5, 0, Math.PI * 1.65);
    ctx.strokeStyle = '#ffcc44'; ctx.lineWidth = 1.8;
    ctx.globalAlpha = 0.75; ctx.stroke();
    ctx.rotate(Math.PI);
    ctx.beginPath(); ctx.arc(0, 0, r + 5, 0, Math.PI * 0.75);
    ctx.strokeStyle = '#ff9900'; ctx.lineWidth = 1.2;
    ctx.globalAlpha = 0.45; ctx.stroke();
    ctx.restore();
    ctx.globalAlpha = 1;
  }
  if (rank === 10 && t != null) {
    const ang = (t * 0.002) % (Math.PI * 2);
    ctx.save(); ctx.translate(cx, cy);
    ctx.rotate(ang);
    ctx.beginPath(); ctx.arc(0, 0, r + 5, 0, Math.PI * 1.65);
    ctx.strokeStyle = '#bef4f4'; ctx.lineWidth = 1.8;
    ctx.globalAlpha = 0.75; ctx.stroke();
    ctx.rotate(Math.PI);
    ctx.beginPath(); ctx.arc(0, 0, r + 5, 0, Math.PI * 0.75);
    ctx.strokeStyle = '#54c4c4'; ctx.lineWidth = 1.2;
    ctx.globalAlpha = 0.45; ctx.stroke();
    ctx.restore();
    ctx.globalAlpha = 1;
  }

  ctx.beginPath(); ctx.arc(cx, cy, r, 0, Math.PI * 2);
  if (rank === 1) {
    const g = ctx.createRadialGradient(cx-4,cy-5,1,cx,cy,r);
    g.addColorStop(0,'#fff4a0'); g.addColorStop(0.55,'#ffcc00'); g.addColorStop(1,'#9a5e00');
    ctx.fillStyle = g;
  } else if (rank === 2) {
    const g = ctx.createRadialGradient(cx-3,cy-4,1,cx,cy,r);
    g.addColorStop(0,'#eef4f8'); g.addColorStop(1,'#506070');
    ctx.fillStyle = g;
  } else if (rank === 3) {
    const g = ctx.createRadialGradient(cx-3,cy-4,1,cx,cy,r);
    g.addColorStop(0,'#f0b060'); g.addColorStop(1,'#6a2800');
    ctx.fillStyle = g;
  } else if (rank === 10) {
    const g = ctx.createRadialGradient(cx-3,cy-4,1,cx,cy,r);
    g.addColorStop(0,'#54c4c4'); g.addColorStop(1,'#bef4f4');
    ctx.fillStyle = g;
  } else {
    ctx.fillStyle = 'rgba(34,24,50,0.88)';
  }
  ctx.fill();
  ctx.strokeStyle = rank === 1 ? 'rgba(255,220,100,0.55)' :
                    rank <= 3  ? 'rgba(255,255,255,0.18)' : 'rgba(68,48,88,0.55)';
  ctx.lineWidth = rank === 1 ? 1.5 : 1; ctx.stroke();

  ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
  ctx.font = rank === 1 ? 'bold 13px sans-serif' :
             rank === 2 ? 'bold 11px sans-serif' :
             rank === 3 ? 'bold 10px sans-serif' : '9px sans-serif';
             rank === 10 ? 'bold 13px sans-serif' :
  ctx.fillStyle = rank <= 3 ? '#1a0e08' : '#7777aa';
  ctx.fillText(rank, cx, cy + 0.5);
  ctx.textBaseline = 'alphabetic';
  ctx.restore();
}

