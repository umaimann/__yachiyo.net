}

// ══════════════════════════════════════════════════════
// INTRO / START SCENE ANIMATION
// ══════════════════════════════════════════════════════
let ia = null;
function resetIA() {
  ia = {
    t: 0,
    netA: 0,
    glowR: 0,
    bulge: 0,
    bursted: false,
    shockwaves: [],
    frags: [],
    shipY: CH / 2,
    voiceA: 0,
    voiceDone: false,
    ready: false,
    tapA: 0,
  };
  bubble = null; parts.length = 0;
}
resetIA();

function tickIA(dt) {
  ia.t += dt;
  const t = ia.t;

  ia.netA = t < 500 ? 0 : Math.min(1, (t - 500) / 700);

  if (t > 2100 && !ia.bursted) {
    const prog = Math.min(1, (t - 2100) / 1000);
    ia.glowR  = prog * 65;
    ia.bulge  = prog;
  }

  if (t > 3100 && !ia.bursted) {
    ia.bursted = true;
    playSfx('warp');
    ia.shockwaves.push({ r: 0, a: 1 }, { r: 0, a: 0.6 });
    for (let i = 0; i < 32; i++) {
      const ang = Math.random() * Math.PI * 2;
      const spd = Math.random() * 5.5 + 1.8;
      ia.frags.push({
        x: CW/2, y: CH / 2,
        vx: Math.cos(ang)*spd, vy: Math.sin(ang)*spd,
        r: Math.random()*3.5+0.8, a: 1,
        c: Math.random() < 0.55 ? '#8888aa' : '#ccccff',
      });
    }
    spawn(CW/2, CH/2, 55, { c: '#ff6688', spd: 9, dc: 0.013, r: 2.5 });
    spawn(CW/2, CH/2, 30, { c: '#4466ff', spd: 6, dc: 0.011, r: 1.8 });
    gs.flash = 1;
  }

  ia.shockwaves.forEach(sw => { sw.r += 8; sw.a = Math.max(0, sw.a - 0.038); });

  if (t > 3300) ia.shipY += (660 - ia.shipY) * 0.06;

  ia.frags = ia.frags.filter(f => {
    f.x += f.vx; f.y += f.vy; f.a -= 0.022; return f.a > 0;
  });

  if (t > 4400) {
    const elapsed = t - 4400;
    if (elapsed < 600)        ia.voiceA = elapsed / 600;
    else if (elapsed < 2600)  ia.voiceA = 1;
    else if (elapsed < 3200)  ia.voiceA = 1 - (elapsed - 2600) / 600;
    else                      ia.voiceA = 0;
  }

  if (t > 5800) { ia.ready = true; ia.tapA = Math.min(1, (t - 5800) / 500); }

  if (t > 8500) advanceIA();

  if (gs.flash > 0) gs.flash -= 0.05;
  tickParts(dt); tickStars(dt); tickLines(dt); tickBubble(dt);
}

function drawIA() {
  const bg = ctx.createLinearGradient(0, 0, 0, CH);
  bg.addColorStop(0, '#04040f'); bg.addColorStop(1, '#0a0618');
  ctx.fillStyle = bg; ctx.fillRect(0, 0, CW, CH);
  drawStars(); drawLines(); drawParts();

  const na = ia.netA * (ia.bursted ? Math.max(0, 1 - (ia.t - 3100) / 350) : 1);
  if (na > 0) drawNet(na, ia.bursted ? 0 : ia.bulge);

  if (ia.glowR > 0 && !ia.bursted) {
    const g = ctx.createRadialGradient(CW/2, CH/2, 0, CW/2, CH/2, ia.glowR);
    g.addColorStop(0, 'rgba(255,255,255,0.85)'); g.addColorStop(1, 'rgba(94,82,84,0)');
    ctx.beginPath(); ctx.arc(CW/2, CH/2, ia.glowR, 0, Math.PI*2);
    ctx.fillStyle = g; ctx.fill();
  }

  ia.shockwaves.forEach(sw => {
    if (sw.a <= 0) return;
    ctx.beginPath(); ctx.arc(CW/2, CH/2, sw.r, 0, Math.PI*2);
    ctx.strokeStyle = `rgba(255,110,160,${sw.a})`; ctx.lineWidth = 3; ctx.stroke();
  });

  ia.frags.forEach(f => {
    ctx.save(); ctx.globalAlpha = f.a;
    ctx.beginPath(); ctx.arc(f.x, f.y, f.r, 0, Math.PI*2);
    ctx.fillStyle = f.c; ctx.fill(); ctx.restore();
  });

  if (ia.t > 3300) drawShip(CW/2, ia.shipY);

  if (ia.voiceA > 0) {
    ctx.save();
    ctx.globalAlpha = ia.voiceA;
    ctx.textAlign = 'center';
    ctx.font = 'bold 19px sans-serif';
    ctx.fillStyle = `rgb(210,70,70)`;
    ctx.shadowColor = 'rgba(200,50,50,0.5)';
    ctx.shadowBlur  = 12;
    ctx.fillText(T.start, CW/2, CH / 2 - 30);
    ctx.restore();
    ctx.textAlign = 'left';
  }

  if (ia.tapA > 0) {
    ctx.font = '12px sans-serif'; ctx.fillStyle = `rgba(170,170,200,${ia.tapA * 0.75})`;
    ctx.textAlign = 'center'; ctx.fillText(T.tap_start, CW/2, CH - 44); ctx.textAlign = 'left';
  }

  if (gs.flash > 0) { ctx.fillStyle = `rgba(255,255,255,${gs.flash})`; ctx.fillRect(0, 0, CW, CH); }
}

function drawNet(alpha, bulge) {
  bulge = bulge || 0;
  const mg  = 0.30;
  const ox  = -CW * mg, oy = -CH * mg;
  const nw  = CW * (1 + mg * 2), nh = CH * (1 + mg * 2);
  const cols = 11, rows = 14;
  const cw  = nw / cols, ch = nh / rows;

  const bx = CW/2, by = CH / 2;
  const maxDisp = 280 * bulge;

  function pt(c, r) {
    const x = ox + c * cw, y = oy + r * ch;
    if (bulge <= 0) return { x, y };
    const dx = x - bx, dy = y - by;
    const d  = Math.hypot(dx, dy) || 1;
    const falloff = Math.max(0, 1 - d / 440);
    const disp    = maxDisp * falloff * falloff;
    return { x: x + (dx/d) * disp, y: y + (dy/d) * disp };
  }

  ctx.save();
  ctx.globalAlpha = alpha * 0.65;
  ctx.strokeStyle = '#8888aa'; ctx.lineWidth = 0.8;

  for (let r = 0; r <= rows; r++) {
    ctx.beginPath();
    for (let c = 0; c <= cols; c++) {
      const p = pt(c, r);
      c === 0 ? ctx.moveTo(p.x, p.y) : ctx.lineTo(p.x, p.y);
    }
    ctx.stroke();
  }
  for (let c = 0; c <= cols; c++) {
    ctx.beginPath();
    for (let r = 0; r <= rows; r++) {
      const p = pt(c, r);
      r === 0 ? ctx.moveTo(p.x, p.y) : ctx.lineTo(p.x, p.y);
    }
    ctx.stroke();
  }
  ctx.globalAlpha = alpha * 0.22; ctx.strokeStyle = '#ccccff'; ctx.lineWidth = 0.4;
  for (let r = 0; r < rows; r++) for (let c = 0; c < cols; c++) {
    const p0 = pt(c, r), p1 = pt(c+1, r+1);
    ctx.beginPath(); ctx.moveTo(p0.x, p0.y); ctx.lineTo(p1.x, p1.y); ctx.stroke();
  }
  ctx.restore();
}

function advanceIA() {
  if (scene !== 'intro' && scene !== 'startScene') return;
  if (introTarget === 'modeSelect') { goState('modeSelect'); }
  else { goState('game'); initGame(); }
}

