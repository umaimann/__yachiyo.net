      ctx.globalAlpha = alpha * 0.5; ctx.stroke(); ctx.globalAlpha = alpha;
    }

    // �､��� ��
    ctx.beginPath(); ctx.arc(sx, sy, SWATCH_R, 0, Math.PI * 2);
    ctx.fillStyle = col.body; ctx.fill();
    ctx.strokeStyle = sel ? col.stroke : 'rgba(90,80,110,0.6)';
    ctx.lineWidth = sel ? 1.5 : 0.8; ctx.stroke();

    // �ｸ�� ���ｴ
    ctx.save(); ctx.translate(sx, sy);
    _drawShipShape(5, col);
    ctx.restore();
  });

  ctx.textAlign = 'left';
  ctx.restore();
}

