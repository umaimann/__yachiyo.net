}

// ══════════════════════════════════════════════════════
// BULLET SYSTEM
// ══════════════════════════════════════════════════════
const BCOL = {
  basic:  '#4FC3F7', wave:  '#CE93D8', homing: '#FFCC02',
  burst:  '#FF7043', meteor: '#A1887F', accel_homing: '#FF6D00',
};
const bullets = [];
function mkBullet(type, x, y, vx, vy, opts) {
  opts = opts || {};
  const hspd = opts.hspd || 1.8;
  return {
    type, x, y, vx, vy,
    r:    opts.r  || (type === 'meteor' ? 8 : 5),
    col:  BCOL[type] || '#fff',
    age:  0,
    alive: true,
    wAmp: opts.wAmp || 2,
    wFrq: opts.wFrq || 0.08,
    bvx: vx, bvy: vy,
    burstAt: opts.burstAt || 0,
    hspd,
    hspdMax:   opts.hspdMax   || hspd,
    accelRate: opts.accelRate || 0,
    warnMs: opts.warnMs || 0,
    rampMs: opts.rampMs || 0,
    tvx: vx, tvy: vy,
  };
}
function tickBullets(dt) {
  const ship = gs.ship;
  const dtN = dt / 8.333;
  for (let i = bullets.length - 1; i >= 0; i--) {
    const b = bullets[i]; if (!b.alive) { bullets.splice(i,1); continue; }
    b.age += dt;
    if (b.type === 'wave') {
      const t = b.age * b.wFrq;
      const len = Math.hypot(b.bvx, b.bvy) || 1;
      const px = -b.bvy / len, py = b.bvx / len;
      b.x += (b.bvx + px * Math.sin(t) * b.wAmp) * dtN;
      b.y += (b.bvy + py * Math.sin(t) * b.wAmp) * dtN;
    } else if (b.type === 'homing' || b.type === 'accel_homing') {
      if (b.accelRate > 0) {
        b.hspd = Math.min(b.hspdMax, b.hspd + b.accelRate * dt / 1000);
      }
      const dtN = dt / 8.333;
      const trackDur  = b.type === 'accel_homing' ? 3200 : 2100;
      const trackFade = 1400;
      let steerBase = b.type === 'accel_homing' ? 0.022 : 0.028;
      if (b.age > trackDur) {
        const fade = Math.max(0, 1 - (b.age - trackDur) / trackFade);
        steerBase *= fade;
      }
      const steer = steerBase > 0 ? 1 - Math.pow(1 - steerBase, dtN) : 0;
      if (steer > 0) {
        const dx = ship.x - b.x, dy = ship.y - b.y;
        const d  = Math.hypot(dx, dy) || 1;
        const targetVx = (dx / d) * b.hspd;
        const targetVy = (dy / d) * b.hspd;
        b.vx += (targetVx - b.vx) * steer;
        b.vy += (targetVy - b.vy) * steer;
      }
      const spd = Math.hypot(b.vx, b.vy);
      if (spd > b.hspd) { b.vx *= b.hspd / spd; b.vy *= b.hspd / spd; }
      b.x += b.vx * dtN; b.y += b.vy * dtN;
    } else if (b.type === 'burst') {
      if (b.age >= b.warnMs) {
        b.x += b.vx * dtN; b.y += b.vy * dtN;
      }
      if (b.burstAt > 0 && b.age > b.burstAt) {
        for (let a = 0; a < 5; a++) {
          const ang = (a / 5) * Math.PI * 2;
          bullets.push(mkBullet('basic', b.x, b.y, Math.cos(ang)*2.2, Math.sin(ang)*2.2,
            { rampMs: 420 }));
        }
        playSfx('surroundBurst');
        bullets.splice(i, 1); continue;
      }
    } else {
      if (b.rampMs > 0 && b.age < b.rampMs) {
        const t = b.age / b.rampMs;
        const scale = t * t;
        b.x += b.tvx * scale * dtN;
        b.y += b.tvy * scale * dtN;
      } else {
        b.x += b.vx * dtN; b.y += b.vy * dtN;
      }
    }
    if (b.x < -30 || b.x > CW+30 || b.y < -30 || b.y > CH+30) { bullets.splice(i,1); }
  }
}
function drawBullets() {
  bullets.forEach(b => {
    ctx.save();

    if (b.type === 'burst' && b.warnMs > 0 && b.age < b.warnMs) {
      const prog  = b.age / b.warnMs;
      const pulse = (Math.sin(b.age * 0.018) + 1) * 0.5;
      const ringR = b.r * (3.8 - prog * 2.2);
      ctx.globalAlpha = 0.18 + pulse * 0.28;
      ctx.strokeStyle = BCOL.burst;
      ctx.lineWidth = 1.4;
      ctx.beginPath(); ctx.arc(b.x, b.y, ringR, 0, Math.PI * 2); ctx.stroke();
      ctx.globalAlpha = 0.25 + prog * 0.55;
      const grd = ctx.createRadialGradient(b.x, b.y, 0, b.x, b.y, b.r * 2.0);
      grd.addColorStop(0, BCOL.burst); grd.addColorStop(1, 'transparent');
      ctx.beginPath(); ctx.arc(b.x, b.y, b.r * 2.0, 0, Math.PI * 2);
      ctx.fillStyle = grd; ctx.fill();
      ctx.restore();
      return;
    }

    const grd = ctx.createRadialGradient(b.x, b.y, 0, b.x, b.y, b.r * 2.4);
    grd.addColorStop(0, b.col); grd.addColorStop(1, 'transparent');
    ctx.beginPath(); ctx.arc(b.x, b.y, b.r * 2.4, 0, Math.PI*2);
    ctx.fillStyle = grd; ctx.fill();
    ctx.beginPath(); ctx.arc(b.x, b.y, b.r * 0.55, 0, Math.PI*2);
    ctx.fillStyle = '#fff'; ctx.fill();
    ctx.restore();
  });
}

