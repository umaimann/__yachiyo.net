// ══════════════════════════════════════════════════════
// STARS
// ══════════════════════════════════════════════════════
const stars = [];
function initStars() {
  stars.length = 0;
  for (let i = 0; i < 130; i++) stars.push({
    x: Math.random() * CW, y: Math.random() * CH,
    r: Math.random() * 1.1 + 0.2,
    spd: Math.random() * 0.7 + 0.15,
    a: Math.random() * 0.22 + 0.07,
  });
}
initStars();
function tickStars(dt) {
  const dtN = dt / 8.333;
  stars.forEach(s => { s.y += s.spd * dtN; if (s.y > CH) { s.y = 0; s.x = Math.random() * CW; } });
}
function drawStars() {
  stars.forEach(s => {
    ctx.beginPath(); ctx.arc(s.x, s.y, s.r, 0, Math.PI*2);
    ctx.fillStyle = `rgba(200,220,255,${s.a})`; ctx.fill();
  });
}

// ══════════════════════════════════════════════════════
// ENERGY LINES
// ══════════════════════════════════════════════════════
const eLines = [];
function mkLine() {
  const angle = (Math.random() * 50 - 25) * Math.PI / 180;
  const spd   = Math.random() * 3 + 2;
  return {
    x: Math.random() * CW, y: -Math.random() * CH,
    len: Math.random() * 110 + 50,
    vx: Math.sin(angle) * spd, vy: Math.cos(angle) * spd,
    a: Math.random() * 0.15 + 0.04,
    col: Math.random() < 0.6 ? '#00c8ff' : '#8866ff',
    w: Math.random() * 1.1 + 0.3,
  };
}
function initLines(n) { eLines.length = 0; for (let i = 0; i < n; i++) eLines.push(mkLine()); }
initLines(12);
function tickLines(dt) {
  const dtN = dt / 8.333;
  eLines.forEach((l, i) => {
    l.x += l.vx * dtN; l.y += l.vy * dtN;
    if (l.y > CH + l.len) eLines[i] = mkLine();
  });
}
function drawLines() {
  eLines.forEach(l => {
    ctx.save();
    ctx.globalAlpha = l.a;
    ctx.strokeStyle = l.col; ctx.lineWidth = l.w;
    ctx.beginPath();
    ctx.moveTo(l.x, l.y);
    ctx.lineTo(l.x - l.vx * l.len / l.vy, l.y - l.len);
    ctx.stroke();
    ctx.restore();
  });
}

// ══════════════════════════════════════════════════════
// PARTICLES
// ══════════════════════════════════════════════════════
const parts = [];
function spawn(x, y, n, opts) {
  for (let i = 0; i < n; i++) {
    const a   = Math.random() * Math.PI * 2;
    const spd = (opts.spd || 3) * (Math.random() * 0.7 + 0.65);
    parts.push({
      x, y,
      vx: Math.cos(a) * spd, vy: Math.sin(a) * spd,
      r:  opts.r   || Math.random() * 2.5 + 0.8,
      a:  1,
      dc: opts.dc  || 0.022,
      c:  opts.c   || '#ff6688',
      g:  opts.g   || 0.04,
    });
  }
}
function tickParts(dt) {
  const dtN = dt / 8.333;
  for (let i = parts.length - 1; i >= 0; i--) {
    const p = parts[i];
    p.x += p.vx * dtN; p.y += p.vy * dtN; p.vy += p.g * dtN; p.a -= p.dc * dtN;
    if (p.a <= 0) parts.splice(i, 1);
  }
}
function drawParts() {
  parts.forEach(p => {
    ctx.save(); ctx.globalAlpha = p.a;
    ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI*2);
    ctx.fillStyle = p.c; ctx.fill(); ctx.restore();
  });
}

// ══════════════════════════════════════════════════════
// SPEECH BUBBLE
// ══════════════════════════════════════════════════════
let bubble = null;
function showBubble(text, ms) {
  bubble = { full: text, disp: '', ti: 0, tt: 0, a: 0, timer: ms, fin: false };
}
function tickBubble(dt) {
  if (!bubble) return;
  bubble.timer -= dt;
  if (bubble.timer < 500) {
    bubble.a = Math.max(0, bubble.a - 0.055);
    if (bubble.a <= 0) { bubble = null; return; }
  } else {
    bubble.a = Math.min(1, bubble.a + 0.1);
  }
  if (bubble.ti < bubble.full.length) {
    bubble.tt += dt;
    while (bubble.tt > 30 && bubble.ti < bubble.full.length) {
      bubble.tt -= 30; bubble.disp += bubble.full[bubble.ti++];
    }
  }
}
function drawBubble(ax, ay) {
  if (!bubble) return;
  ctx.save(); ctx.globalAlpha = bubble.a;
  const W = 240, pad = 11, lh = 17, r = 10;
  ctx.font = '12px sans-serif';
  const lines = wrapLines(bubble.disp, W - pad*2);
  const H = lines.length * lh + pad * 2;
  const bx = Math.max(8, Math.min(CW - W - 8, ax - W/2));
  const by = ay - H - 20;

  roundRect(ctx, bx, by, W, H, r);
  ctx.fillStyle = 'rgba(20,12,28,0.93)'; ctx.fill();
  ctx.strokeStyle = '#5E5254'; ctx.lineWidth = 1.5; ctx.stroke();

  ctx.beginPath();
  ctx.moveTo(ax - 7, by + H); ctx.lineTo(ax, by + H + 13); ctx.lineTo(ax + 7, by + H);
  ctx.fillStyle = 'rgba(20,12,28,0.93)'; ctx.fill();

  ctx.font = '12px sans-serif'; ctx.fillStyle = '#eaeaea';
  lines.forEach((ln, i) => ctx.fillText(ln, bx + pad, by + pad + lh + i * lh - 2));

  ctx.restore();
}
function wrapLines(text, maxW) {
  const out = []; let line = '';
  for (const ch of text) {
    const test = line + ch;
    if (ctx.measureText(test).width > maxW && line) { out.push(line); line = ch; }
    else line = test;
  }
  if (line) out.push(line);
  return out.length ? out : [''];
}
function roundRect(ctx, x, y, w, h, r) {
  ctx.beginPath();
  ctx.moveTo(x + r, y);
  ctx.lineTo(x + w - r, y); ctx.arcTo(x + w, y, x + w, y + r, r);
  ctx.lineTo(x + w, y + h - r); ctx.arcTo(x + w, y + h, x + w - r, y + h, r);
  ctx.lineTo(x + r, y + h); ctx.arcTo(x, y + h, x, y + h - r, r);
  ctx.lineTo(x, y + r); ctx.arcTo(x, y, x + r, y, r);
  ctx.closePath();
}

