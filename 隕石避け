};

let _sessionToken = null; // �護桷 �懍梠 �� �ｸ�ｬ �懋ｸ雅ｰ幗捩 奝�增ｰ

function initGame() {
  gs.ship.x = CW/2; gs.ship.y = 660;
  gs.time = 0; gs.phase = 0;
  // �護桷 �懍梠 �懍�川乱 奝�增ｰ �懋ｸ� (�罹ｲ� ���: elapsed >= score)
  _sessionToken = null;
  fetch('/api/kaguya/token').then(r => r.ok ? r.json() : null).then(d => { _sessionToken = d; }).catch(() => {});
  gs.alive = true; gs.forcedM = null; gs.flash = 0;
  gs.finale = false; gs.finaleTime = 0; gs.earthAlpha = 0;
  gs.precision = false; gs.breathe = false; gs.breatheTimer = 0; gs.paused = false;
  gs._mile60 = false; gs._mile120 = false;
  bullets.length = 0; lasers.length = 0; parts.length = 0; shipTrail.length = 0; _trailFrame = 0;
  patCycle = 0; patTimer = 0; debrisTimer = 0; basicTimer = 0;
  bubble = null;
