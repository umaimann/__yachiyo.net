  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <title>髫慕浹繧医￠</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body {
      height: 100%;
    }
    body {
      margin: 0; padding: 0;
      background: #000;
      display: flex;
      justify-content: center;
      align-items: center;
      width: 100%;
      overflow: hidden;
      touch-action: none;
    }
    #gameWrap {
      position: relative;
      display: inline-block;
      /* 嶹罷ｩｴ�� �� �ｨ�� ��惠 ��� */
      width:  min(480px, 100vw, calc(100svh * 0.6), calc(100vh * 0.6));
      height: min(800px, calc(min(480px, 100vw, calc(100svh * 0.6), calc(100vh * 0.6)) * 800 / 480));
    }
    #gameCanvas {
      display: block;
      width: 100%;
      height: 100%;
      image-rendering: pixelated;
    }
    #langBar {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 100;
    }
    #rankingBtnWrap {
      position: absolute;
      bottom: 8px; right: 8px;
      display: flex; gap: 4px;
      pointer-events: auto;
    }
    .lbtn {
      background: rgba(30,20,40,0.8);
      color: #aaa;
      border: 1px solid rgba(94,82,84,0.4);
      border-radius: 4px;
      padding: 3px 8px;
      cursor: pointer;
      font-size: 11px;
      font-family: sans-serif;
      touch-action: manipulation;  /* ��款 夋ｭ �罹�溢擽 �懋ｱｰ */
    }
    .lbtn.on { color: #eaeaea; border-color: #5E5254; background: rgba(94,82,84,0.5); }
    #rankingBtn { color: #bb99ff; border-color: rgba(136,85,204,0.5); }
    #nameInputOverlay {
      display: none;
      position: absolute;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      width: 76%;
      background: rgba(8,4,20,0.95);
      border: 1px solid rgba(94,82,84,0.55);
      border-radius: 14px;
      padding: 22px 20px 18px;
      z-index: 210;
      flex-direction: column;
      gap: 12px;
      font-family: sans-serif;
    }
    #nameInputTime {
      text-align: center;
      color: #9988cc;
      font-size: 22px;
      font-weight: bold;
      letter-spacing: 0.05em;
    }
    #nameInput {
      background: rgba(20,12,36,0.9);
      color: #eaeaea;
      border: 1px solid rgba(94,82,84,0.6);
      border-radius: 8px;
      padding: 10px 14px;
      font-size: 15px;
      font-family: sans-serif;
      outline: none;
      text-align: center;
      width: 100%;
      box-sizing: border-box;
    }
    #nameInput:focus { border-color: #9988cc; }
    #nameInputTier {
      display: none;
      text-align: center;
      font-size: 12px;
      font-weight: bold;
      letter-spacing: 0.12em;
      margin-top: -4px;
    }
    #nameInputTier.tier-gm {
      background: linear-gradient(90deg,#ff6644,#ffcc00,#44ff88,#4488ff,#cc44ff,#ff6644);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    #nameInputBtns { display: flex; gap: 10px; }
    .pauseActionBtn.secondary {
      background: rgba(30,22,46,0.8);
      color: #888899;
      border-color: rgba(94,82,84,0.4);
    }
    #pauseOverlay {
      display: none;
      position: absolute;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      width: 72%;
      background: rgba(8,4,20,0.93);
      border: 1px solid rgba(94,82,84,0.5);
      border-radius: 12px;
      padding: 22px 20px 18px;
      z-index: 200;
      flex-direction: column;
      gap: 14px;
      font-family: sans-serif;
    }
    #pauseTitle {
      text-align: center;
      color: #ddd;
      font-size: 15px;
      font-weight: bold;
      letter-spacing: 0.08em;
      margin-bottom: 4px;
    }
    .pauseRow {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .pauseLabel {
      color: #aaa;
      font-size: 12px;
      width: 44px;
      flex-shrink: 0;
    }
    .pauseMuteBtn {
      background: rgba(30,20,40,0.8);
      color: #ccc;
      border: 1px solid rgba(94,82,84,0.4);
      border-radius: 4px;
      padding: 2px 7px;
      cursor: pointer;
      font-size: 12px;
      flex-shrink: 0;
      touch-action: manipulation;
    }
    .pauseSlider {
      flex: 1;
      height: 4px;
      cursor: pointer;
      accent-color: #9988cc;
    }
    #pauseBtns {
      display: flex;
      gap: 10px;
      margin-top: 4px;
    }
    .pauseActionBtn {
      flex: 1;
      background: rgba(60,48,76,0.8);
      color: #eaeaea;
      border: 1px solid #5E5254;
      border-radius: 8px;
      padding: 9px 0;
      cursor: pointer;
      font-size: 13px;
      font-weight: bold;
      font-family: sans-serif;
      touch-action: manipulation;
    }
    .pauseActionBtn:active { background: rgba(94,72,110,0.9); }
  </style>
