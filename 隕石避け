// SCENE: QUICK RESTART
// 笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武
let qrState = { t: 0 };
function drawQuickRestart() {
  qrState.t += 16;
  const t = qrState.t;

  // �ｰ�ｽ �肥��
  ctx.fillStyle = 'rgba(4,4,15,0.92)'; ctx.fillRect(0, 0, CW, CH);

  // "�ｸ��共�ｴ �ｴ�ｬ�ｼ �､�� 﨑罹ｲ�!" 窶� 寬們擽�懍攤 弡� ���
  const textA = t < 180 ? 0 : t < 500 ? (t - 180) / 320 : t < 1000 ? 1 : Math.max(0, 1 - (t - 1000) / 300);
  if (textA > 0) {
    ctx.save(); ctx.globalAlpha = textA;
    ctx.textAlign = 'center'; ctx.font = 'bold 19px sans-serif';
    ctx.fillStyle = 'rgb(210,70,70)';
    ctx.shadowColor = 'rgba(200,50,50,0.5)'; ctx.shadowBlur = 12;
    ctx.fillText(T.start, CW/2, CH/2 - 30);
    ctx.restore(); ctx.textAlign = 'left';
  }

  if (t > 1500) { qrState.t = 0; goState('game'); initGame(); }
}

// 笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武
// SCENE: GAME OVER
// 笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武
let goAlpha = 0;
const BTN_RETRY = { x: 70, y: 560, w: 140, h: 50 };
const BTN_MENU  = { x: 270, y: 560, w: 140, h: 50 };

function goState_gameoverInit() {
  goAlpha = 0;
  if (gameMode === 'endless') setTimeout(() => showNameInput(gs.time), 700);
}

function drawGameover(dt) {
  goAlpha = Math.min(1, goAlpha + 0.022 * (dt/8.333));
  drawGame();
  ctx.fillStyle = 'rgba(4,4,15,0.75)'; ctx.fillRect(0, 0, CW, CH);
  ctx.save(); ctx.globalAlpha = goAlpha; ctx.textAlign = 'center';

  // �肥攤 �ｬ�� �肥┷�
  ctx.font = 'bold 17px sans-serif'; ctx.fillStyle = '#eaeaea';
  const dlines = wrapLines(T.death, CW - 80);
  dlines.forEach((l, i) => ctx.fillText(l, CW/2, 285 + i * 24));

  ctx.font = '12px sans-serif'; ctx.fillStyle = '#666688';
  ctx.fillText(T.time_label + ': ' + gs.time.toFixed(2) + 's', CW/2, 370);
  if (gameMode === 'endless') {
    const best = parseFloat(localStorage.getItem(CFG.BEST_KEY) || 0);
    ctx.fillText(T.best_label + ': ' + best.toFixed(2) + 's', CW/2, 390);
  }

  drawBtn(BTN_RETRY, T.retry, false);
  drawBtn(BTN_MENU,  T.menu,  false);
  ctx.restore(); ctx.textAlign = 'left';
}

// 笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武
// SCENE: CLEAR 80
// 笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武
let c80Alpha = 0;
function drawClear80(dt) {
  c80Alpha = Math.min(1, c80Alpha + 0.018 * (dt/8.333));
  tickParts(dt); tickStars(dt); tickLines(dt);
  const bg = ctx.createLinearGradient(0, 0, 0, CH);
  bg.addColorStop(0, '#04040f'); bg.addColorStop(1, '#0a0618');
  ctx.fillStyle = bg; ctx.fillRect(0, 0, CW, CH);
  drawStars(); drawLines(); drawParts();
  ctx.save(); ctx.globalAlpha = c80Alpha; ctx.textAlign = 'center';

  ctx.font = 'bold 20px sans-serif'; ctx.fillStyle = '#eaeaea';
