// ══════════════════════════════════════════════════════
// SHIP GHOST TRAIL
// ══════════════════════════════════════════════════════
const shipTrail = [];
const TRAIL_MAX    = 7;
const TRAIL_LIFE   = 380;
const TRAIL_ALPHA  = 0.23;
const TRAIL_SKIP   = 2;
let   _trailFrame  = 0;

function pushTrail(x, y) {
  _trailFrame++;
  if (_trailFrame < TRAIL_SKIP) return;
  _trailFrame = 0;
  shipTrail.push({ x, y, age: 0 });
  if (shipTrail.length > TRAIL_MAX) shipTrail.shift();
}

function tickTrail(dt) {
  for (let i = shipTrail.length - 1; i >= 0; i--) {
    shipTrail[i].age += dt;
    if (shipTrail[i].age >= TRAIL_LIFE) shipTrail.splice(i, 1);
  }
}

function drawTrail() {
  for (let i = 0; i < shipTrail.length; i++) {
    const t = shipTrail[i];
    const frac  = 1 - t.age / TRAIL_LIFE;
    const order = (i + 1) / shipTrail.length;
    const alpha = frac * order * TRAIL_ALPHA;
    if (alpha < 0.005) continue;
    ctx.save();
    ctx.globalAlpha = alpha;
    ctx.translate(t.x, t.y);
    _drawShipShape(18);
    ctx.restore();
  }
}

function _drawShipShape(s, col) {
  col = col || getShipColor();
  ctx.beginPath();
  ctx.moveTo(0, -s); ctx.lineTo(-s * 0.55, s * 0.68); ctx.lineTo(s * 0.55, s * 0.68);
  ctx.closePath(); ctx.fillStyle = col.body; ctx.fill();
  ctx.strokeStyle = col.stroke; ctx.lineWidth = Math.max(1, s * 0.085); ctx.stroke();
  ctx.save();
  ctx.beginPath();
  ctx.moveTo(0, -s); ctx.lineTo(-s * 0.55, s * 0.68); ctx.lineTo(s * 0.55, s * 0.68);
  ctx.closePath(); ctx.clip();
  ctx.strokeStyle = col.stripe; ctx.lineWidth = Math.max(0.8, s * 0.072);
  const bands = [-s * 0.48, -s * 0.20, s * 0.10, s * 0.40, s * 0.64];
  bands.forEach(ly => {
    ctx.beginPath();
    ctx.moveTo(-s * 0.75, ly + s * 0.14);
    ctx.lineTo( s * 0.75, ly - s * 0.07);
    ctx.stroke();
  });
  ctx.restore();
}

