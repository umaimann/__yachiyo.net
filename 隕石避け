function drawForcedMeteor(m) {
  ctx.save(); ctx.globalAlpha = m.a;
  // Dark shadow vignette
  const sh = ctx.createRadialGradient(m.x, m.y, m.r * 0.5, m.x, m.y, m.r * 1.8);
  sh.addColorStop(0, 'rgba(20,8,4,0.55)'); sh.addColorStop(1, 'rgba(0,0,0,0)');
  ctx.beginPath(); ctx.arc(m.x, m.y, m.r * 1.8, 0, Math.PI*2);
  ctx.fillStyle = sh; ctx.fill();
  // Body
  const grd = ctx.createRadialGradient(m.x - m.r*0.28, m.y - m.r*0.28, 0, m.x, m.y, m.r);
  grd.addColorStop(0, '#8D6E63'); grd.addColorStop(0.5, '#5D4037'); grd.addColorStop(1, '#3E2723');
  ctx.beginPath(); ctx.arc(m.x, m.y, m.r, 0, Math.PI*2);
  ctx.fillStyle = grd; ctx.fill();
  // Cracks
  ctx.strokeStyle = '#BCAAA4'; ctx.lineWidth = 0.9; ctx.globalAlpha = m.a * 0.5;
  for (let i = 0; i < 10; i++) {
    const a = (i / 10) * Math.PI * 2 + 0.3;
    const r1 = m.r * 0.25, r2 = m.r * (0.55 + (i%3)*0.12);
    ctx.beginPath();
    ctx.moveTo(m.x + Math.cos(a)*r1, m.y + Math.sin(a)*r1);
    ctx.lineTo(m.x + Math.cos(a+0.12)*r2, m.y + Math.sin(a+0.12)*r2);
    ctx.stroke();
  }
  ctx.restore();
}

