function playBGM(key) {
  stopBGM();
  const a = bgm[key]; if (!a) return;
  a.volume = bgmMuted ? 0 : bgmVolume;
  a.currentTime = 0;
  a.play().catch(() => {});
  activeBgm = a;
}
function stopBGM() {
  if (!activeBgm) return;
  activeBgm.pause(); activeBgm.currentTime = 0; activeBgm = null;
}

const _sfxRaw = {};
const sfxBuf  = {};
let _sfxDecoding = false, _sfxDecoded = false;

(async function prefetchSfx() {
  await Promise.all(Object.entries(SFX_FILES).map(async ([key, url]) => {
    try {
      const r = await fetch(url);
      if (r.ok) _sfxRaw[key] = await r.arrayBuffer();
    } catch {}
  }));
})();

function getAC() {
  if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
  if (audioCtx.state === 'suspended') audioCtx.resume();
  return audioCtx;
}

async function ensureDecoded() {
  if (_sfxDecoded || _sfxDecoding) return;
  _sfxDecoding = true;
  const ac = getAC();
  await Promise.all(Object.entries(_sfxRaw).map(async ([key, raw]) => {
    try { sfxBuf[key] = await ac.decodeAudioData(raw.slice()); } catch {}
  }));
  _sfxDecoded = true;
}

function playSfx(key) {
  if (muted) return;
  ensureDecoded().then(() => {
    if (!sfxBuf[key]) return;
    const ac  = getAC();
    const src = ac.createBufferSource();
    src.buffer = sfxBuf[key];
    const g = ac.createGain();
    g.gain.value = sfxVolume;
    src.connect(g); g.connect(ac.destination);
    src.start();
  });
}


