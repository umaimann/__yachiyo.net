const _nameSkipBtn      = document.getElementById('nameSkipBtn');

function showNameInput(timeSec) {
  _nameInputTime.textContent = fmtScore(timeSec);
  const tier = getScoreTier(timeSec);
  if (tier) {
    _nameInputTier.textContent = '✦ ' + tier.label + ' ✦';
    _nameInputTier.className   = tier.rainbow ? 'tier-gm' : '';
    _nameInputTier.style.color = tier.rainbow ? '' : tier.col;
    _nameInputTier.style.display = 'block';
  } else {
    _nameInputTier.style.display = 'none';
  }
  _nameInput.value           = localStorage.getItem('kaguya_player_name') || '';
  _nameInput.placeholder     = T.name_placeholder;
  _nameSubmitBtn.textContent = T.name_submit;
  _nameSkipBtn.textContent   = T.name_skip;
  _nameInputOverlay.style.display = 'flex';
  setTimeout(() => _nameInput.focus(), 80);
}
function hideNameInput() {
  _nameInputOverlay.style.display = 'none';
}
async function _submitScore(name) {
  hideNameInput();
  if (name) localStorage.setItem('kaguya_player_name', name);
  const playerName = name || 'YOU';
  try {
    const {token, ts, sig} = _sessionToken || await fetch('/api/kaguya/token')
      .then(r => { if (!r.ok) throw 0; return r.json(); });
    const data = await fetch('/api/kaguya/score', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({token, ts, sig, name: playerName, score: gs.time}),
    }).then(r => { if (!r.ok) throw 0; return r.json(); });
    if (!data.ok) throw 0;
    goLeaderboard(data.scores, data.rank, playerName);
  } catch (_) {
    const mockBase = [
      {name:'umaimann', score:480016.8, country:'JP'},
      {name:'CometGirl', score:40.0, country:'KR'},
      {name:'Tsukiko',   score:35.2, country:'JP'},
      {name:'StarDust',  score:31.8, country:'US'},
      {name:'Iroha',     score:28.4, country:'KR'},
      {name:'Yukine',    score:25.9, country:'JP'},
      {name:'MoonChild', score:22.0, country:'TW'},
      {name:'Himari',    score:19.7, country:'KR'},
      {name:'NovaBurst', score:17.3, country:'US'},
      {name:'yachiyo8000◆oCrOwWQM5w',    score: 252455616000.0, country:'JP'},,
    ];
    const playerEntry = {name: playerName, score: gs.time, country: '??', isPlayer: true};
    const all = [...mockBase, playerEntry].sort((a,b) => b.score - a.score);
    const scores = all.map((r,i) => ({...r, rank: i+1}));
    goLeaderboard(scores, scores.findIndex(r => r.isPlayer)+1, playerName);
  }
}
_nameSubmitBtn.addEventListener('click', e => { e.stopPropagation(); _submitScore(_nameInput.value.trim()); });
