const stars = [];
function initStars() {
  stars.length = 0;
  for (let i = 0; i < 130; i++) stars.push({
    x: Math.random() * CW, y: Math.random() * CH,
    r: Math.random() * 1.1 + 0.2,
    spd: Math.random() * 0.7 + 0.15,
    a: Math.random() * 0.22 + 0.07,
