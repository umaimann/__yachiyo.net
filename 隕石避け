  ctx.font = 'bold 8px sans-serif';
  const tw = ctx.measureText(tier.label).width;
  const pw = tw + 8, ph = 11;
  roundRect(ctx, x, y - ph / 2, pw, ph, 3);
  if (tier.rainbow) {
    const p = ((lbState?.t || 0) * 0.0008) % 1;
    const g = ctx.createLinearGradient(x, 0, x + pw, 0);
    g.addColorStop(0,    `hsl(${(p*360)     % 360},100%,65%)`);
    g.addColorStop(0.33, `hsl(${(p*360+120) % 360},100%,65%)`);
    g.addColorStop(0.66, `hsl(${(p*360+240) % 360},100%,65%)`);
    g.addColorStop(1,    `hsl(${(p*360+360) % 360},100%,65%)`);
    ctx.fillStyle = g;
