// LASER SYSTEM
// ══════════════════════════════════════════════════════
const lasers = [];
function spawnLaser(x1, y1, x2, y2, warn) {
  const fireMax = 1100;
  playSfx('laserWarn');
  lasers.push({ x1, y1, x2, y2, warn: warn || 950, fire: fireMax, fireMax, phase: 'warn' });
}
function tickLasers(dt) {
  for (let i = lasers.length - 1; i >= 0; i--) {
    const l = lasers[i];
    if (l.phase === 'warn') { l.warn -= dt; if (l.warn <= 0) { l.phase = 'fire'; playSfx('laserFire'); } }
    else { l.fire -= dt; if (l.fire <= 0) lasers.splice(i, 1); }
  }
}
function drawLasers() {
  lasers.forEach(l => {
    ctx.save();
    if (l.phase === 'warn') {
      ctx.setLineDash([4, 6]);
      ctx.strokeStyle = 'rgba(255,68,68,0.40)'; ctx.lineWidth = 1.0;
      ctx.beginPath(); ctx.moveTo(l.x1, l.y1); ctx.lineTo(l.x2, l.y2); ctx.stroke();
      ctx.setLineDash([]);
    } else {
      const elapsed  = l.fireMax - l.fire;
      const rampUp   = 160;
      const sustain  = l.fireMax - rampUp - 380;
      const rampDown = 380;
      let lw, alpha;
      if (elapsed < rampUp) {
        const t = elapsed / rampUp;
        lw    = 0.4 + t * t * 7.6;
        alpha = 0.5 + t * 0.5;
      } else if (elapsed < rampUp + sustain) {
        lw    = 8; alpha = 1;
      } else {
        const t = (elapsed - rampUp - sustain) / rampDown;
        lw    = 8 * Math.pow(1 - t, 1.4);
        alpha = 1 - t * t;
      }
      lw = Math.max(0.3, lw);
      ctx.strokeStyle = `rgba(255,68,68,${alpha.toFixed(2)})`;
      ctx.lineWidth   = lw;
      ctx.shadowColor = '#FF4444';
      ctx.shadowBlur  = 12 * alpha;
      ctx.beginPath(); ctx.moveTo(l.x1, l.y1); ctx.lineTo(l.x2, l.y2); ctx.stroke();
    }
    ctx.restore();
  });
}
function laserHit(sx, sy) {
  for (const l of lasers) {
    if (l.phase !== 'fire') continue;
    const dx = l.x2 - l.x1, dy = l.y2 - l.y1;
    const len2 = dx*dx + dy*dy; if (!len2) continue;
    const t = Math.max(0, Math.min(1, ((sx-l.x1)*dx + (sy-l.y1)*dy) / len2));
    if (Math.hypot(l.x1+t*dx-sx, l.y1+t*dy-sy) < CFG.HITBOX_R + 4) return true;
  }
  return false;
}

