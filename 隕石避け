    rampMs: opts.rampMs || 0,   // �ｴ�� �懍梠 弡� �ｴ �懋ｰ� �呷譜 0竊�1 ��� (�ｩ嵂･ �一ｳ�)
    tvx: vx, tvy: vy,           // ramp �ｰ� �ｩ岺� �鷺巡
  };
