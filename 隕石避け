      } else {
        const t = (elapsed - rampUp - sustain) / rampDown;
        lw    = 8 * Math.pow(1 - t, 1.4);  // �懍�德� ��符��
        alpha = 1 - t * t;                  // �醐血�� �懍�德� �川�
      }
