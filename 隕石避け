function getScoreTier(sec) {
  for (const tier of LB_TIERS) if (sec >= tier.min) return tier;
  return null;
}
function getRankTier(rank) {
  if (rank === 1) return LB_TIERS[0]; // GM
  if (rank <= 3)  return LB_TIERS[1];  // Diamond
  if (rank <= 5)  return LB_TIERS[2];  // Platinum
  if (rank <= 7)  return LB_TIERS[3];  // Gold
  if (rank <= 9)  return LB_TIERS[4];  // Silver
  if (rank <= 10) return LB_TIERS[5]; // Bronze
}
function _drawTierBadge(tier, x, y) {
  if (!tier) return;
