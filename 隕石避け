// PATTERNS
// ══════════════════════════════════════════════════════
const PATTERN_SETS = [
  ['debris_arc', 'debris_arc', 'radial_slow'],
  ['debris_arc', 'radial_slow', 'scatter'],
  ['spiral', 'wall', 'scatter', 'debris_arc'],
  ['cross_laser', 'homing_rush', 'spiral', 'scatter'],
  ['cross_laser', 'surround', 'homing_rush', 'spiral', 'scatter'],
  ['surround', 'cross_laser', 'spiral', 'homing_rush', 'scatter'],
  ['surround', 'cross_laser', 'homing_rush', 'wall'],
  ['surround', 'cross_laser', 'homing_rush', 'radial_slow', 'scatter'],
  ['surround', 'cross_laser', 'homing_rush', 'radial_slow', 'scatter', 'spiral', 'wall'],
  ['precision_homing', 'accel_homing', 'cross_laser', 'surround', 'scatter'],
  ['precision_homing', 'accel_homing', 'surround', 'cross_laser', 'spiral', 'wall'],
  ['precision_homing', 'accel_homing', 'precision_homing', 'surround', 'cross_laser', 'scatter'],
];
let patCycle = 0;
let patTimer = 0;
let debrisTimer = 0;
let basicTimer = 0;

function patInterval(phase) { return Math.max(420, 1400 - phase * 90); }

function firePat(phase) {
  const set = PATTERN_SETS[Math.min(phase, PATTERN_SETS.length - 1)];
  let name = set[patCycle % set.length]; patCycle++;
  if (name === 'wall' && Math.random() > 0.20) name = 'scatter';
  execPat(name, phase);
}

function execPat(name, phase) {
  const cx = CW / 2;
  const spd  = 1.5 + phase * 0.22;
  const bspd = spd * 0.80;
  switch (name) {
    case 'debris_arc': {
      const n = 9 + phase;
      const offset = Math.random() * Math.PI * 2;
      for (let i = 0; i < n; i++) {
        const a  = offset + (i / n) * Math.PI * 2;
        const ox = cx + Math.cos(a) * (CW * 0.55);
        const oy = -20 + Math.random() * 40;
        const ds = 0.55 + Math.random() * 0.55;
        const da = Math.PI / 2 + (Math.random() - 0.5) * 0.35;
        bullets.push(mkBullet('meteor', ox, oy, Math.cos(da)*ds, Math.sin(da)*ds,
          { r: 4 + Math.random() * 5 }));
      }
      break;
    }
    case 'radial_slow': {
      playSfx('scatterWhite');
      const n = 12 + phase * 2;
      const offset = Math.random() * Math.PI * 2;
      for (let i = 0; i < n; i++) {
        const a = offset + (i / n) * Math.PI * 2;
        const s = 0.8 + Math.random() * 0.5;
        bullets.push(mkBullet('meteor', cx, 80, Math.cos(a)*s, Math.sin(a)*s,
          { r: 5 + Math.random() * 4 }));
      }
      break;
    }
    case 'radial': {
      const n = 9 + phase;
      for (let i = 0; i < n; i++) {
        const a = (i / n) * Math.PI * 2;
        bullets.push(mkBullet('basic', cx, -10, Math.cos(a)*bspd, Math.sin(a)*bspd));
      }
      break;
    }
    case 'scatter': {
      playSfx('scatterBlue');
      const n = 7 + phase * 2;
      for (let i = 0; i < n; i++) {
        const x = 30 + Math.random() * (CW - 60);
        const a = Math.PI/2 + (Math.random()-0.5)*0.85;
        const s = bspd + Math.random() * 0.35;
        bullets.push(mkBullet('basic', x, -10, Math.cos(a)*s, Math.sin(a)*s));
      }
      break;
    }
    case 'spiral': {
      playSfx('spiral');
      const base = (Date.now() * 0.003) % (Math.PI * 2);
      const arms = 3;
      for (let arm = 0; arm < arms; arm++) {
        for (let j = 0; j < 4; j++) {
          const a = base + (arm/arms)*Math.PI*2 + j*0.18;
          bullets.push(mkBullet('wave', cx, 60, Math.cos(a)*spd, Math.sin(a)*spd, { wAmp: 1.8, wFrq: 0.06 }));
        }
      }
      break;
    }
    case 'wall': {
      playSfx('scatterWhite');
      const gap  = 70 + Math.random() * 80;
      const gapX = 20 + Math.random() * (CW - gap - 40);
      const cols = Math.ceil(CW / 26);
      for (let c = 0; c < cols; c++) {
        const bx = c * 26 + 13;
        if (bx > gapX && bx < gapX + gap) continue;
        bullets.push(mkBullet('meteor', bx, -10, 0, spd * 0.9));
      }
      break;
    }
    case 'cross_laser': {
      const y1 = 160 + Math.random() * 300;
      const y2 = 160 + Math.random() * 300;
      spawnLaser(0, y1, CW, y1);
      spawnLaser(CW * 0.3, 0, CW * 0.7, CH);
      break;
    }
    case 'homing_rush': {
      const n = Math.min(2 + Math.floor(phase * 0.6), 4);
      for (let i = 0; i < n; i++) {
        setTimeout(() => {
          playSfx('homing');
          bullets.push(mkBullet('homing', 30 + Math.random() * (CW - 60), -10, 0, 1, { hspd: 1.4 + phase * 0.15 }));
        }, i * 320);
      }
      break;
    }
    case 'surround': {
      playSfx('surroundWarn');
      const { x: sx, y: sy } = gs.ship;
      const n      = 6;
      const d      = 340;
      const ss     = spd * 0.50;
      const warnMs = 800;
      const fuse   = Math.max(700, 1100 - phase * 30);
      for (let i = 0; i < n; i++) {
        const a = (i / n) * Math.PI * 2;
        const ox = sx + Math.cos(a) * d, oy = sy + Math.sin(a) * d;
        bullets.push(mkBullet('burst', ox, oy,
          -Math.cos(a) * ss, -Math.sin(a) * ss,
          { burstAt: warnMs + fuse, warnMs }));
      }
      break;
    }
    case 'precision_homing': {
      const extra = phase - 9;
      const n = Math.min(3 + Math.floor(extra * 0.5), 6);
      const hspdVal = 2.6 + extra * 0.18;
      for (let i = 0; i < n; i++) {
        setTimeout(() => {
          playSfx('homing');
          bullets.push(mkBullet('homing',
            30 + Math.random() * (CW - 60), -10, 0, 1,
            { hspd: hspdVal }));
        }, i * 180);
      }
      break;
    }
    case 'accel_homing': {
      const extra = phase - 9;
      const n = Math.min(2 + Math.floor(extra * 0.4), 4);
      const maxSpd = 3.2 + extra * 0.15;
      for (let i = 0; i < n; i++) {
        setTimeout(() => {
          playSfx('homing');
          bullets.push(mkBullet('accel_homing',
            30 + Math.random() * (CW - 60), -10, 0, 0.5,
            { hspd: 0.5, hspdMax: maxSpd, accelRate: 0.9 + extra * 0.06 }));
        }, i * 300);
      }
      break;
    }
  }
}

