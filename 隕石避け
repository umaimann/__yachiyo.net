  ctx.font = '15px sans-serif'; ctx.fillStyle = '#c8c8dd';
  ctx.fillText(T.clear80b, CW/2, 278);

  if (c80Alpha > 0.5) {
    ctx.font = 'bold 13px sans-serif'; ctx.fillStyle = '#c8a86a';
    ctx.fillText('嫌 ' + T.ach_name, CW/2, 320);
    ctx.font = '12px sans-serif'; ctx.fillStyle = '#8888aa';
    ctx.fillText(T.mode_endless + ' ' + T.unlocked, CW/2, 348);
  }

  drawBtn(BTN_MENU, T.menu, false);
  ctx.restore(); ctx.textAlign = 'left';
}

// 笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武
// SCENE NAVIGATION
// 笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武
function goState(s) { scene = s; }

function onTap(x, y) {
  if (_nameInputOverlay.style.display === 'flex') return;
  if (scene === 'leaderboard') {
    if (lbState && lbState.btnAlpha > 0.1) {
      if (lbState.viewOnly) {
        if (inR(x, y, {x:160, y:660, w:160, h:44})) { goState('modeSelect'); msAlpha = 0; bubble = null; }
      } else {
        if (inR(x, y, BTN_LB_RETRY)) { goState('quickRestart'); qrState.t = 0; }
        if (inR(x, y, BTN_LB_MENU))  { stopBGM(); goState('modeSelect'); msAlpha = 0; bubble = null; }
      }
    }
    return;
  }
  if (scene === 'intro' || scene === 'startScene') {
    if (ia.ready) advanceIA();
    return;
  }
  if (scene === 'modeSelect') {
    // �餓メ �､��� ��夋�
    const _n = SHIP_COLORS.length;
    for (let _i = 0; _i < _n; _i++) {
      const _sx = CW / 2 + (_i - (_n - 1) / 2) * SWATCH_SP;
      if (Math.hypot(x - _sx, y - _getSwatchY()) <= SWATCH_R + 6) {
        shipColorId = SHIP_COLORS[_i].id;
        localStorage.setItem('kaguya_ship_color', shipColorId);
        return;
      }
    }
    if (inR(x, y, BTN_NORMAL)) {
      introTarget = 'game'; gameMode = 'normal';
      resetIA(); initLines(14); goState('startScene');
    } else if (inR(x, y, BTN_ENDLESS) && localStorage.getItem(CFG.NORMAL_KEY)) {
      introTarget = 'game'; gameMode = 'endless';
      resetIA(); initLines(14); goState('startScene');
    }
    return;
  }
  if (scene === 'gameover') {
    if (inR(x, y, BTN_RETRY)) { goState('quickRestart'); qrState.t = 0; }
    if (inR(x, y, BTN_MENU))  { stopBGM(); goState('modeSelect'); msAlpha = 0; bubble = null; }
    return;
  }
  if (scene === 'clear80') {
    if (inR(x, y, BTN_MENU)) { stopBGM(); goState('modeSelect'); msAlpha = 0; bubble = null; }
    return;
  }
}
function inR(x, y, r) { return x >= r.x && x <= r.x + r.w && y >= r.y && y <= r.y + r.h; }

// 笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武
// MAIN LOOP
// 笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武
const _langBar = document.getElementById('langBar');
let last = 0;
function loop(now) {
  const dt = Math.min(48, now - last); last = now;
  ctx.clearRect(0, 0, CW, CH);
  _langBar.style.display = scene === 'modeSelect' ? 'block' : 'none';

  if (scene === 'intro') {
    tickIA(dt); drawIA();
  } else if (scene === 'startScene') {
    tickIA(dt); drawIA();
  } else if (scene === 'modeSelect') {
    drawModeSelect(dt);
  } else if (scene === 'game') {
    if (!gs.paused) tickGame(dt);
    drawGame();
  } else if (scene === 'gameover') {
    drawGameover(dt);
  } else if (scene === 'leaderboard') {
    tickLeaderboard(dt); drawLeaderboard();
  } else if (scene === 'clear80') {
    drawClear80(dt);
  } else if (scene === 'quickRestart') {
    drawQuickRestart();
  }

  requestAnimationFrame(loop);
}
requestAnimationFrame(t => { last = t; requestAnimationFrame(loop); });
