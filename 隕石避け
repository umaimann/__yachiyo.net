      // �尖ц�尞ｬ �罷ｲｨ�懦売: elapsed �ｰ�
      const elapsed  = l.fireMax - l.fire;       // �懍ぎ 弡� �ｽ�ｼ ms
      const rampUp   = 160;                       // ����ｵ: 0~160ms
      const sustain  = l.fireMax - rampUp - 380;  // �ｵ�ｰ ��� �ｬ��
      const rampDown = 380;                       // �ｵ竊廷枚+寬們擽��: �溢ｧ�� 380ms
      let lw, alpha;
      if (elapsed < rampUp) {
        const t = elapsed / rampUp;
        lw    = 0.4 + t * t * 7.6;    // ��� �｡���ｼ�� ����ｵ
        alpha = 0.5 + t * 0.5;
      } else if (elapsed < rampUp + sustain) {
