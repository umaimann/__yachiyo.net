  // Ship
  if (ia.t > 3300) drawShip(CW/2, ia.shipY);

  // �ｴ�ｴ�� �ｩ�誤ｦｬ 窶� 嶹罷ｩｴ �卓蕗 ���ｸ 奛作侃孖ｸ
  if (ia.voiceA > 0) {
