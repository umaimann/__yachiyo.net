const JR = 75;
function drawJoystick() {
  if (!touch.on || scene !== 'game') return;
  const ox = touch.ox, oy = touch.oy;
  const dx = touch.cx - ox, dy = touch.cy - oy;
  const dist = Math.hypot(dx, dy);
  const clamp = Math.min(dist, JR);
  const kx = dist > 0 ? ox + (dx / dist) * clamp : ox;
  const ky = dist > 0 ? oy + (dy / dist) * clamp : oy;

  ctx.save();
  // �ｸ�ｽ ��
  ctx.beginPath(); ctx.arc(ox, oy, JR, 0, Math.PI * 2);
  ctx.strokeStyle = 'rgba(180,160,220,0.35)';
  ctx.lineWidth = 1.5; ctx.stroke();
  // �ｸ�ｽ ��它
  ctx.beginPath(); ctx.arc(ox, oy, JR, 0, Math.PI * 2);
  ctx.fillStyle = 'rgba(80,60,120,0.12)'; ctx.fill();
  // �ｸ��
  ctx.beginPath(); ctx.arc(kx, ky, 22, 0, Math.PI * 2);
  ctx.fillStyle = 'rgba(160,140,220,0.40)'; ctx.fill();
  ctx.beginPath(); ctx.arc(kx, ky, 22, 0, Math.PI * 2);
  ctx.strokeStyle = 'rgba(200,180,255,0.55)';
  ctx.lineWidth = 1.2; ctx.stroke();
  ctx.restore();
}

