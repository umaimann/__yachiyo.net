}

function getPhase(t, mode) {
  if (mode === 'endless') {
    if (t < 60)  return Math.min(5, Math.floor(t / 12));
    // 24�壱ｧ壱共 +1 (�ｰ�ｴ 18�� 竊� ��剩), �罹劇 8�� cap
    if (t < 180) return Math.min(8, 5 + Math.floor((t - 60) / 24));
    // 180��~: �簿ｰ�ｬ�ｩ 寬們擽�� (9�奓ｰ �懍梠, 25�壱ｧ壱共 +1)
    return 9 + Math.floor((t - 180) / 25);
  }
  if (t < 15) return 0; if (t < 30) return 1; if (t < 45) return 2;
  if (t < 60) return 3; if (t < 77) return 4; return 5;
}

function moveShip(dt) {
  const dtN = dt / 8.333;
  let dx = 0, dy = 0;
  if (keys['ArrowLeft']  || keys['KeyA']) dx -= 1;
  if (keys['ArrowRight'] || keys['KeyD']) dx += 1;
  if (keys['ArrowUp']    || keys['KeyW']) dy -= 1;
  if (keys['ArrowDown']  || keys['KeyS']) dy += 1;
  if (touch.on) {
    const tx = touch.cx - touch.ox, ty = touch.cy - touch.oy;
    const tl = Math.hypot(tx, ty);
    if (tl > 14) { dx += tx / tl; dy += ty / tl; }
  }
  const l = Math.hypot(dx, dy); if (l > 0) { dx /= l; dy /= l; }
  if (l > 0) pushTrail(gs.ship.x, gs.ship.y);
  gs.ship.x = Math.max(14, Math.min(CW-14, gs.ship.x + dx * CFG.SHIP_SPEED * dtN));
  gs.ship.y = Math.max(14, Math.min(CH-14, gs.ship.y + dy * CFG.SHIP_SPEED * dtN));
}

function checkHit() {
  if (!gs.alive) return;
  const { x: sx, y: sy } = gs.ship;

  // 嵓ｼ���� �卓濫 �ｼ�� 夋�/�溢擽� �ｴ�� 窶� �ｴ�晤ｧ� 甯川��
  if (!gs.finale) {
    for (const b of bullets) {
      const d = Math.hypot(b.x - sx, b.y - sy);
      if (d < CFG.HITBOX_R + b.r * 0.80) { doDie(); return; }
    }
    if (laserHit(sx, sy)) { doDie(); return; }
  }

  if (gs.forcedM) {
    const m = gs.forcedM;
    // �ｴ�� �｣� �ｰ� 嵓ｼ�ｩ (m.y + m.r�ｴ ���� y�ｼ ��們ｹ俯ｩｴ �ｩ��)
    const dist = Math.hypot(m.x - sx, m.y - sy);
    if (dist < m.r * 1.00 + CFG.HITBOX_R) {
      if (gs.finale) { doClear80(); } else { doDie(); }
      return;
    }
  }
}

function doDie() {
  if (!gs.alive) return;
  gs.alive = false;
  stopBGM();
  playSfx('death');
  spawn(gs.ship.x, gs.ship.y, 45, { c: '#ff6688', spd: 6, dc: 0.014 });
  spawn(gs.ship.x, gs.ship.y, 20, { c: '#cc44ff', spd: 4, r: 1.8, dc: 0.018 });
  gs.flash = 1;
  if (gameMode === 'endless') {
    const best = parseFloat(localStorage.getItem(CFG.BEST_KEY) || 0);
    if (gs.time > best) localStorage.setItem(CFG.BEST_KEY, gs.time.toFixed(2));
  }
  setTimeout(() => {
    goState('gameover');
    goState_gameoverInit();
  }, 1100);
}

function doClear80() {
  if (!gs.alive) return;
  gs.alive = false;
  c80Alpha = 0;
  stopBGM();
  stopMeteorSound();
  playSfx('clear');
  spawn(gs.ship.x, gs.ship.y, 60, { c: '#ff6688', spd: 5, dc: 0.011 });
  gs.flash = 1;
  localStorage.setItem(CFG.NORMAL_KEY, '1');
  localStorage.setItem(CFG.ACH_KEY, '1');
  localStorage.setItem('tuku_kaguya_endless_unlocked', '1');
  try {
    if (window.parent && typeof window.parent.unlockKaguyaArtifact === 'function') {
      window.parent.unlockKaguyaArtifact();
    }
  } catch (_) {}
  setTimeout(() => { goState('clear80'); }, 1400);
}

function tickGame(dt) {
  if (!gs.alive) {
    tickParts(dt); if (gs.flash > 0) gs.flash -= 0.05 * (dt/8.333); tickStars(dt); tickLines(dt);
    return;
  }
  // 嵓ｼ���� �卓濫 �護桷 �懋ｰ� �晝ｰ �瀧卿 (夋�ｴ�ｸ 80.0�川� �溢ｶ､)
  if (!gs.finale) gs.time += dt / 1000;

  // Phase change
  const np = getPhase(gs.time, gameMode);
  if (np !== gs.phase) {
    gs.phase = np;
    if (np === 2) showBubble(T.phase2, 2800);
    if (np === 4) {
      showBubble(T.phase4, 2600);
      setTimeout(() => showBubble(T.phase4b, 2400), 3200);
    }
  }

  // 笏笏 �罷糖�ｬ�､ ��圸 �溢攵�､奝､ �ｰ�� 笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏
  if (gameMode === 'endless') {
    // 60s: 嶹罷ｩｴ �� 﨑懍､�ｸｰ 嵓誤椈��
    if (gs.time >= 60 && !gs._mile60) {
      gs._mile60 = true;
      gs.flash = Math.max(gs.flash, 0.18);
    }
    // 120s: �� �鷺巡 1.6�ｰ (�ｰ�ｽ �ｴ�･��)
    if (gs.time >= 120 && !gs._mile120) {
      gs._mile120 = true;
      stars.forEach(s => { s.spd *= 1.6; });
    }
    // �ｴ夋�� �溢攵�､奝､ (168��) 窶� ���� �溢ｻ､
    if (gs.time >= 168 && !gs.precision) {
      gs.precision = true;
      try { localStorage.setItem('tuku_kaguya_newtype', '1'); } catch (_) {}
      try {
        if (window.parent && typeof window.parent.onKaguyaNewtype === 'function') {
          window.parent.onKaguyaNewtype();
        }
      } catch (_) {}
    }
  }

  // 笏笏 �罷糖�ｬ�､ �ｨ ���ｴ�ｰ (�､ 45�壱ｧ壱共 5�一ｰ� 甯ｨ奓ｴ �瀧卿) 笏笏
  if (gameMode === 'endless' && !gs.finale) {
    const cycle = 45000; // 45�� �ｼ�ｰ
    const rest  =  5000; // 5�� 弴ｴ��
    const phase_ms = (gs.time * 1000) % cycle;
    gs.breathe = phase_ms < rest;
    if (gs.breathe) {
      gs.breatheTimer += dt;
    } else {
      gs.breatheTimer = 0;
    }
  }

  // ��ｬ 窶� 60�壱ｶ奓ｰ �懍�德� 寬們擽�懍攤 (�ｸ� �ｨ��)
  if (gameMode === 'normal' && gs.time >= 60) {
    gs.earthAlpha = Math.min(0.85, (gs.time - 60) / 18);
  }

  // BGM 寬們擽�� ��寃 窶� 60�壱ｶ奓ｰ 80�溢乱 0�ｼ�� (�ｸ� �ｨ��)
  if (gameMode === 'normal' && activeBgm && !bgmMuted && gs.time >= 60) {
    const fadeRatio = Math.max(0, 1 - (gs.time - 60) / 20);
    activeBgm.volume = bgmVolume * fadeRatio;
  }

  // 笏笏 嵓ｼ���� ��桿 (�ｸ� 80��) 笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏
  if (gameMode === 'normal' && gs.time >= CFG.FINALE_SEC && !gs.finale) {
    gs.finale = true;
    // ���� �晧┳�� �瀧卿 窶� �ｰ�ｴ 夋�/�溢擽��� �川硫�､�ｽ�� 奣ｴ�･
  }

  if (gs.finale) {
    gs.finaleTime += dt / 1000;
    // 嵓ｼ﨑� �� ��株 �ｴ�� �ｱ�･ (finaleTime >= FINALE_METEOR)
    if (gs.finaleTime >= CFG.FINALE_METEOR && !gs.forcedM) {
      gs.forcedM = { x: CW/2, y: -(CFG.METEOR_R), r: CFG.METEOR_R, a: 0, vy: 65 };
      playMeteorSound();
    }
  }

  if (gs.forcedM) {
    const m = gs.forcedM;
    m.a = Math.min(1, m.a + 0.016);
    m.y += m.vy * dt / 1000;
  }

  moveShip(dt);

  // ��亨 �ｴ�� �被紛 窶� 嵓ｼ���� �卓濫 �晧┳ �瀧卿
  if (!gs.finale) {
    debrisTimer += dt;
    // �壱ｰ�(phase 0~3): �被紛 峵作┳﨑俾ｲ� / phase 4+(�溢擽� �ｱ�･ �ｴ弡�): 弡ｨ�ｬ �ｸ﨑俾ｲ�
    const debrisInterval = gs.phase < 4
      ? Math.max(1000, 2400 - gs.phase * 220)
      : 4200 + gs.phase * 300;
    if (debrisTimer >= debrisInterval) {
      debrisTimer = 0;
      const roll = Math.random();
      if (roll < 0.04) {
        const r  = 38 + Math.random() * 17;
        const x  = 30 + Math.random() * (CW - 60);
        const ds = 0.18 + Math.random() * 0.14;
        const da = Math.PI / 2 + (Math.random() - 0.5) * 0.15;
        bullets.push(mkBullet('meteor', x, -(r + 5), Math.cos(da)*ds, Math.sin(da)*ds, { r }));
      } else if (roll < 0.35) {
        const r  = 10 + Math.random() * 8;
        const x  = 20 + Math.random() * (CW - 40);
        const ds = 0.45 + Math.random() * 0.4;
        const da = Math.PI / 2 + (Math.random() - 0.5) * 0.25;
        bullets.push(mkBullet('meteor', x, -(r + 4), Math.cos(da)*ds, Math.sin(da)*ds, { r }));
      } else {
        const count = Math.random() < 0.35 ? 2 : 1;
        for (let i = 0; i < count; i++) {
          const r  = 4 + Math.random() * 4;
          const x  = 20 + Math.random() * (CW - 40);
          const ds = 0.7 + Math.random() * 0.6;
          const da = Math.PI / 2 + (Math.random() - 0.5) * 0.45;
          bullets.push(mkBullet('meteor', x, -(r + 4), Math.cos(da)*ds, Math.sin(da)*ds, { r }));
        }
      }
    }
  }

  // 甯ｨ奓ｴ �懍ぎ 窶� 嵓ｼ���� �瀧卿, �罷糖�ｬ�､ �ｨ ���ｴ�ｰ �ｬ��巡 �瀧卿
  if (!gs.finale && !gs.breathe) {
    patTimer += dt;
    if (patTimer >= patInterval(gs.phase)) { patTimer = 0; firePat(gs.phase); }
  }

  // �罷糖�ｬ�､ 135��~: �ｰ�ｸ夋�(basic) �ｰ尞ｬ 窶� 甯ｨ奓ｴ�ｼ ��ｰ罹｡� �ｸ�德� �ｴ�､�ｴ
  if (gameMode === 'endless' && gs.time >= 135 && !gs.finale && !gs.breathe) {
    basicTimer += dt;
    // 135s=2000ms ��ｲｩ 竊� �懋ｰ�擽 �溢��� ��符�� (�懍� 800ms)
    const basicInterval = Math.max(800, 2000 - (gs.time - 135) * 7);
    if (basicTimer >= basicInterval) {
      basicTimer = 0;
      const count = gs.time >= 180 ? 3 : 2;
      const spd   = 1.4 + (gs.time - 135) * 0.008;
      for (let i = 0; i < count; i++) {
        const x = 30 + Math.random() * (CW - 60);
        const a = Math.PI / 2 + (Math.random() - 0.5) * 0.6;
        bullets.push(mkBullet('basic', x, -10, Math.cos(a) * spd, Math.sin(a) * spd));
      }
    }
  }

  tickBullets(dt); tickLasers(dt); tickParts(dt); tickStars(dt); tickLines(dt);
  tickTrail(dt); tickBubble(dt); checkHit();

  if (gs.flash > 0) gs.flash -= 0.05;
}

