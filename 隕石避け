  ctx.font = 'bold 13px monospace'; ctx.textAlign = 'center';
  if (gs.precision) {
    const pulse = 0.75 + Math.sin(Date.now() * 0.006) * 0.25;
    ctx.fillStyle = `rgba(255,${Math.round(80 + pulse * 40)},80,${pulse.toFixed(2)})`;
    ctx.shadowColor = '#ff4040'; ctx.shadowBlur = 6;
  } else if (gameMode === 'endless' && gs.breathe) {
    ctx.fillStyle = '#88ddff'; ctx.shadowBlur = 0;
  } else {
    ctx.fillStyle = '#ddd'; ctx.shadowBlur = 0;
  }
  ctx.fillText(gs.time.toFixed(2) + 's', CW/2, 20);
  ctx.shadowBlur = 0;
  ctx.textAlign = 'left';
  if (gameMode === 'normal') {
    const pct = Math.min(1, gs.time / CFG.FINALE_SEC);
    ctx.fillStyle = '#222233'; ctx.fillRect(10, 25, CW - 20, 3);
    if (gs.finale) {
      const t = Date.now() * 0.004;
      const bw = CW - 20;
      const grad = ctx.createLinearGradient(10, 0, 10 + bw, 0);
      for (let i = 0; i <= 6; i++) {
        grad.addColorStop(i/6, `hsl(${(t * 180 + i * 60) % 360},100%,65%)`);
      }
