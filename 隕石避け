// ══════════════════════════════════════════════════════
// SCENE NAVIGATION
// ══════════════════════════════════════════════════════
function goState(s) { scene = s; }

function onTap(x, y) {
  if (_nameInputOverlay.style.display === 'flex') return;
  if (scene === 'leaderboard') {
    if (lbState && lbState.btnAlpha > 0.1) {
      if (lbState.viewOnly) {
        if (inR(x, y, {x:160, y:660, w:160, h:44})) { goState('modeSelect'); msAlpha = 0; bubble = null; }
      } else {
        if (inR(x, y, BTN_LB_RETRY)) { goState('quickRestart'); qrState.t = 0; }
        if (inR(x, y, BTN_LB_MENU))  { stopBGM(); goState('modeSelect'); msAlpha = 0; bubble = null; }
      }
    }
    return;
  }
  if (scene === 'intro' || scene === 'startScene') {
    if (ia.ready) advanceIA();
    return;
  }
  if (scene === 'modeSelect') {
    const _n = SHIP_COLORS.length;
    for (let _i = 0; _i < _n; _i++) {
