let ia = null; // intro animation state
function resetIA() {
  ia = {
    t: 0,
    netA: 0,      // net alpha
    glowR: 0,     // pre-burst glow radius
    bulge: 0,     // net bulge factor 0竊�1
    bursted: false,
    shockwaves: [],
    frags: [],
    shipY: CH / 2,
    voiceA: 0,    // "�ｸ��共�ｴ �ｴ�ｬ�ｼ �､�� 﨑罹ｲ�!" �ｴ�ｴ �ｩ�誤ｦｬ alpha
    voiceDone: false,
    ready: false,
    tapA: 0,
  };
  bubble = null; parts.length = 0;
}
resetIA();

function tickIA(dt) {
  ia.t += dt;
  const t = ia.t;

  // Net fade in
  ia.netA = t < 500 ? 0 : Math.min(1, (t - 500) / 700);

  // Glow + bulge build-up
  if (t > 2100 && !ia.bursted) {
    const prog = Math.min(1, (t - 2100) / 1000);
    ia.glowR  = prog * 65;
    ia.bulge  = prog;           // 0竊�1, �ｸ�ｼ�ｴ �川�� �壱｣ｩ﨑俾ｲ�
  }

  // Burst at 3100ms
  if (t > 3100 && !ia.bursted) {
    ia.bursted = true;
    playSfx('warp');
    ia.shockwaves.push({ r: 0, a: 1 }, { r: 0, a: 0.6 });
    for (let i = 0; i < 32; i++) {
      const ang = Math.random() * Math.PI * 2;
      const spd = Math.random() * 5.5 + 1.8;
      ia.frags.push({
        x: CW/2, y: CH / 2,
        vx: Math.cos(ang)*spd, vy: Math.sin(ang)*spd,
        r: Math.random()*3.5+0.8, a: 1,
        c: Math.random() < 0.55 ? '#8888aa' : '#ccccff',
      });
    }
    spawn(CW/2, CH/2, 55, { c: '#ff6688', spd: 9, dc: 0.013, r: 2.5 });
    spawn(CW/2, CH/2, 30, { c: '#4466ff', spd: 6, dc: 0.011, r: 1.8 });
    gs.flash = 1;
  }

  // Shockwaves
  ia.shockwaves.forEach(sw => { sw.r += 8; sw.a = Math.max(0, sw.a - 0.038); });

  // Ship slide in 窶� 嶹罷ｩｴ �卓蕗�川� �護桷 �懍梠 ��ｹ�(660)�� �懍�德� �ｴ��
  if (t > 3300) ia.shipY += (660 - ia.shipY) * 0.06;

  // Fragments
  ia.frags = ia.frags.filter(f => {
    f.x += f.vx; f.y += f.vy; f.a -= 0.022; return f.a > 0;
  });

  // �ｴ�ｴ�� �ｩ�誤ｦｬ: 寬們擽�懍攤 竊� ��� 竊� 寬們擽�懍符��
  if (t > 4400) {
    const elapsed = t - 4400;
    if (elapsed < 600)        ia.voiceA = elapsed / 600;          // 0.6�� 寬們擽�懍攤
    else if (elapsed < 2600)  ia.voiceA = 1;                      // 2�� ���
    else if (elapsed < 3200)  ia.voiceA = 1 - (elapsed - 2600) / 600; // 0.6�� 寬們擽�懍符��
    else                      ia.voiceA = 0;
  }

  // Tap hint
  if (t > 5800) { ia.ready = true; ia.tapA = Math.min(1, (t - 5800) / 500); }

  // Auto advance
  if (t > 8500) advanceIA();

  if (gs.flash > 0) gs.flash -= 0.05;
  tickParts(dt); tickStars(dt); tickLines(dt); tickBubble(dt);
}

function drawIA() {
  const bg = ctx.createLinearGradient(0, 0, 0, CH);
