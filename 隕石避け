// SCENE: LEADERBOARD
// 笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武笊絶武
const LB_ROW_Y0    = 126;
const LB_ROW_H     = 46;
const LB_TITLE_DUR = 500;
const LB_ROW_START = 650;
const LB_ROW_DT    = 120;
const BTN_LB_RETRY = { x: 50,  y: 660, w: 160, h: 44 };
const BTN_LB_MENU  = { x: 270, y: 660, w: 160, h: 44 };
let lbState = null;

function goLeaderboard(scores, playerRank, playerName) {
  lbState = {
    t: 0,
    scores, playerRank, playerName,
    playerRowIdx:   -1,
    playerRevealed: false,
    playerRevealT:  0,
    flashAlpha:     0,
    glowPulse:      0,
    btnAlpha:       0,
  };
  bubble = null; parts.length = 0;
  goState('leaderboard');
}

function _lbRows() {
  if (!lbState) return [];
  const {scores, playerRank, viewOnly} = lbState;
  if (viewOnly) return scores.slice(0, 10);
  if (playerRank <= 10) return scores.slice(0, 10);
  return [...scores.slice(0, 9), {isSep:true}, scores.find(s => s.isPlayer)];
}

function tickLeaderboard(dt) {
  if (!lbState) return;
  lbState.t += dt;
  tickParts(dt); tickStars(dt); tickLines(dt); tickBubble(dt);
  const rows = _lbRows();
  if (lbState.playerRowIdx < 0)
    lbState.playerRowIdx = rows.findIndex(r => r && r.isPlayer);
  const pIdx    = lbState.playerRowIdx;
  const revealT = pIdx >= 0 ? LB_ROW_START + pIdx * LB_ROW_DT : 99999;
  if (!lbState.playerRevealed && pIdx >= 0 && lbState.t > revealT) {
    lbState.playerRevealed = true;
    lbState.playerRevealT  = lbState.t;
    const ry = LB_ROW_Y0 + pIdx * LB_ROW_H + LB_ROW_H / 2;
    const sc = getShipColor();
    spawn(CW/2, ry, 40, {c: sc.stroke,  spd:5,   dc:0.013});
    spawn(CW/2, ry, 20, {c: '#ffffff',  spd:3,   r:1.5, dc:0.017});
    spawn(CW/2, ry, 15, {c: '#cc88ff',  spd:4,   dc:0.015});
    spawn(CW/2, ry, 12, {c: '#ffcc44',  spd:2.5, r:2,   dc:0.014});
    setTimeout(() => showBubble(getRankMsg(lbState.playerRank), 5500), 500);
  }
  if (lbState.playerRevealed) {
    const since       = lbState.t - lbState.playerRevealT;
    lbState.flashAlpha = since < 300 ? (1 - since/300) * 0.75 : 0;
    lbState.glowPulse  = (Math.sin(lbState.t * 0.005) + 1) / 2;
  }
  // viewOnly: ��ｲｴ 嵂� �ｵ�� 弡� ��款 岺懍亨 (�溢ｧ�� 嵂� + 600ms)
  const lastRowT = LB_ROW_START + (_lbRows().length - 1) * LB_ROW_DT;
  const btnT = lbState.viewOnly
    ? lastRowT + 600
    : lbState.playerRevealT > 0 ? lbState.playerRevealT + 1800 : 99999;
  if (lbState.t > btnT)
    lbState.btnAlpha = Math.min(1, lbState.btnAlpha + 0.025 * (dt/8.333));
}

function _rankBadge(rank, cx, cy, t) {
  const r = rank === 1 ? 16 : rank === 2 ? 13 : rank === 3 ? 11 : 10;
  ctx.save();

  // 1�� ��圸: �緋ｹ･ 巐護�� ��
  if (rank === 1 && t != null) {
    const ang = (t * 0.0014) % (Math.PI * 2);
    ctx.save(); ctx.translate(cx, cy);
    ctx.rotate(ang);
    ctx.beginPath(); ctx.arc(0, 0, r + 5, 0, Math.PI * 1.65);
    ctx.strokeStyle = '#ffcc44'; ctx.lineWidth = 1.8;
    ctx.globalAlpha = 0.75; ctx.stroke();
    ctx.rotate(Math.PI);
    ctx.beginPath(); ctx.arc(0, 0, r + 5, 0, Math.PI * 0.75);
    ctx.strokeStyle = '#ff9900'; ctx.lineWidth = 1.2;
    ctx.globalAlpha = 0.45; ctx.stroke();
    ctx.restore();
    ctx.globalAlpha = 1;
  }

  ctx.beginPath(); ctx.arc(cx, cy, r, 0, Math.PI * 2);
  if (rank === 1) {
    const g = ctx.createRadialGradient(cx-4,cy-5,1,cx,cy,r);
    g.addColorStop(0,'#fff4a0'); g.addColorStop(0.55,'#ffcc00'); g.addColorStop(1,'#9a5e00');
    ctx.fillStyle = g;
  } else if (rank === 2) {
    const g = ctx.createRadialGradient(cx-3,cy-4,1,cx,cy,r);
    g.addColorStop(0,'#eef4f8'); g.addColorStop(1,'#506070');
    ctx.fillStyle = g;
  } else if (rank === 3) {
    const g = ctx.createRadialGradient(cx-3,cy-4,1,cx,cy,r);
    g.addColorStop(0,'#f0b060'); g.addColorStop(1,'#6a2800');
    ctx.fillStyle = g;
  } else {
    ctx.fillStyle = 'rgba(34,24,50,0.88)';
  }
  ctx.fill();
  ctx.strokeStyle = rank === 1 ? 'rgba(255,220,100,0.55)' :
                    rank <= 3  ? 'rgba(255,255,255,0.18)' : 'rgba(68,48,88,0.55)';
  ctx.lineWidth = rank === 1 ? 1.5 : 1; ctx.stroke();

  ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
  ctx.font = rank === 1 ? 'bold 13px sans-serif' :
             rank === 2 ? 'bold 11px sans-serif' :
             rank === 3 ? 'bold 10px sans-serif' : '9px sans-serif';
  ctx.fillStyle = rank <= 3 ? '#1a0e08' : '#7777aa';
  ctx.fillText(rank, cx, cy + 0.5);
  ctx.textBaseline = 'alphabetic';
  ctx.restore();
}

function _goldName(text, x, y, t) {
  const tw = ctx.measureText(text).width;
  const p  = (Math.sin(t * 0.0022) + 1) / 2;
  const g  = ctx.createLinearGradient(x, 0, x + tw, 0);
  g.addColorStop(0,                     '#d4900c');
  g.addColorStop(Math.max(0, p - 0.22), '#d4900c');
  g.addColorStop(p,                     '#fffaaa');
  g.addColorStop(Math.min(1, p + 0.22), '#c88010');
  g.addColorStop(1,                     '#e0a020');
  ctx.shadowColor = '#ffcc00'; ctx.shadowBlur = 18;
  ctx.fillStyle = g; ctx.fillText(text, x, y);
  ctx.shadowBlur = 0;
}
function _silverName(text, x, y) {
  const tw = ctx.measureText(text).width;
  const g  = ctx.createLinearGradient(x, 0, x+tw, 0);
  g.addColorStop(0,'#8aabb8'); g.addColorStop(0.45,'#eef4fa'); g.addColorStop(1,'#8aabb8');
  ctx.shadowColor = '#b8d0e8'; ctx.shadowBlur = 10;
  ctx.fillStyle = g; ctx.fillText(text, x, y);
  ctx.shadowBlur = 0;
}
function _bronzeName(text, x, y) {
  const tw = ctx.measureText(text).width;
  const g  = ctx.createLinearGradient(x, 0, x+tw, 0);
  g.addColorStop(0,'#8a4a08'); g.addColorStop(0.45,'#eea848'); g.addColorStop(1,'#8a4a08');
  ctx.shadowColor = '#c06828'; ctx.shadowBlur = 8;
  ctx.fillStyle = g; ctx.fillText(text, x, y);
  ctx.shadowBlur = 0;
}

function drawLeaderboard() {
  if (!lbState) return;
  const t = lbState.t;

  // �ｰ�ｽ
  const bg = ctx.createLinearGradient(0,0,0,CH);
  bg.addColorStop(0,'#04040f'); bg.addColorStop(1,'#080418');
  ctx.fillStyle = bg; ctx.fillRect(0,0,CW,CH);
  drawStars(); drawLines(); drawParts();

  // 夋�ｴ寀
  const titleA = Math.min(1, t / LB_TITLE_DUR);
  ctx.save(); ctx.globalAlpha = titleA; ctx.textAlign = 'center';
  if (Math.sin(t * 0.0031) > 0.87) {
    ctx.globalAlpha = titleA * 0.5;
    ctx.font = 'bold 24px sans-serif';
    ctx.fillStyle = '#ff2244'; ctx.fillText('笨ｦ RANKING 笨ｦ', CW/2-2, 68);
    ctx.fillStyle = '#22ffee'; ctx.fillText('笨ｦ RANKING 笨ｦ', CW/2+2, 68);
    ctx.globalAlpha = titleA;
  }
  ctx.shadowColor = '#8855ff'; ctx.shadowBlur = 20;
  ctx.font = 'bold 24px sans-serif'; ctx.fillStyle = '#e8e8fc';
  ctx.fillText('笨ｦ RANKING 笨ｦ', CW/2, 68);
  ctx.shadowBlur = 0;
  ctx.font = '11px sans-serif'; ctx.fillStyle = '#55556e';
  const best = parseFloat(localStorage.getItem(CFG.BEST_KEY) || 0);
  if (best > 0) ctx.fillText(T.best_label + '  ' + fmtScore(best), CW/2, 90);
  ctx.strokeStyle = 'rgba(94,82,130,0.35)'; ctx.lineWidth = 1;
  ctx.beginPath(); ctx.moveTo(20,104); ctx.lineTo(CW-20,104); ctx.stroke();
  ctx.restore();

  // 嵂� �誤鵠��
  const rows = _lbRows();
  rows.forEach((row, i) => {
    const rowT  = LB_ROW_START + i * LB_ROW_DT;
    if (t < rowT) return;
    const age   = t - rowT;
    const alpha = Math.min(1, age / 160);
    const slide = Math.max(0, (1 - Math.min(1, age/200)) * 16);
    const ry    = LB_ROW_Y0 + i * LB_ROW_H;
    const rcy   = ry + LB_ROW_H/2 + slide;
    const nameY = rcy + 2;       // �ｴ�� �ｰ��� (�ｽ�� ��)
    const tierY = nameY + 13;    // �ｱ�� ��ｧ �ｰ��� (�ｴ�� �罷｡� ��椈)
    const isP   = row.isPlayer;
    // �ｬ�ｱ: �護垈 22px
    const RX = 22, RW = CW - 44;

    ctx.save(); ctx.globalAlpha = alpha;

    // �ｬ��│
    if (row.isSep) {
      ctx.textAlign = 'center'; ctx.font = '12px sans-serif'; ctx.fillStyle = '#2a2a40';
      ctx.fillText('ﾂｷ ﾂｷ ﾂｷ ﾂｷ ﾂｷ ﾂｷ ﾂｷ ﾂｷ ﾂｷ', CW/2, rcy + 5);
      ctx.restore(); return;
    }

    const rowTier = getRankTier(row.rank);

    // 嵂� �ｰ�ｽ
    if (isP) {
      const sc  = getShipColor();
      const rgb = _hexToRgb(sc.stroke);
      ctx.fillStyle = `rgba(${rgb},${0.10 + lbState.glowPulse * 0.09})`;
      roundRect(ctx, RX, ry+4, RW, LB_ROW_H-8, 8); ctx.fill();
      ctx.strokeStyle = sc.stroke; ctx.lineWidth = 1.3;
      ctx.globalAlpha = alpha * (0.4 + lbState.glowPulse * 0.6);
      roundRect(ctx, RX, ry+4, RW, LB_ROW_H-8, 8); ctx.stroke();
      ctx.globalAlpha = alpha;
      if (lbState.flashAlpha > 0) {
        ctx.fillStyle = `rgba(255,255,255,${lbState.flashAlpha})`;
        roundRect(ctx, RX, ry+4, RW, LB_ROW_H-8, 8); ctx.fill();
        ctx.globalAlpha = alpha;
      }
    } else if (row.rank <= 3) {
      const cols = ['200,168,28','172,188,200','156,106,46'];
      ctx.fillStyle = `rgba(${cols[row.rank-1]},0.07)`;
      roundRect(ctx, RX, ry+4, RW, LB_ROW_H-8, 8); ctx.fill();
    }

    // �懍怱 ��ｧ (cx=38)
    _rankBadge(row.rank, 38, rcy + slide, t);

    // �雅└�� (x=60)
    ctx.textAlign = 'left';
    ctx.font = row.rank===1 ? 'bold 15px sans-serif' :
               row.rank<=3  ? 'bold 13px sans-serif' :
               isP          ? 'bold 12px sans-serif' : '12px sans-serif';
    if      (row.rank===1) _gmName            (row.name, 60, nameY, t);
    else if (row.rank===2) _diamondName       (row.name, 60, nameY, t);
    else if (row.rank===3) _emeraldDiamondName(row.name, 60, nameY, t);
    else if (isP) {
      const sc = getShipColor();
      ctx.shadowColor = sc.stroke; ctx.shadowBlur = 10;
      ctx.fillStyle = '#eeeeff'; ctx.fillText(row.name, 60, nameY);
      ctx.shadowBlur = 0;
    } else {
      ctx.fillStyle = '#b8b9cc'; ctx.fillText(row.name, 60, nameY);
    }

    // YOU 夋懋ｷｸ
    if (isP) {
      const nw = ctx.measureText(row.name).width;
      ctx.font = '9px sans-serif'; ctx.fillStyle = getShipColor().stroke;
      ctx.fillText('笆ｶ YOU', 60 + nw + 6, nameY);
    }

    // �ｱ�� ��ｧ (�ｴ�� ��椈)
    _drawTierBadge(rowTier, 60, tierY + slide);

    // �川� (�ｰ�簿�ｬ, x=362)
    ctx.textAlign = 'right';
    ctx.font = row.rank<=3 ? 'bold 12px sans-serif' : '11px sans-serif';
    if (row.rank === 1) {
      const scoreText = fmtScore(row.score);
      const stw = ctx.measureText(scoreText).width;
      const sp  = (Math.sin(t * 0.0022) + 1) / 2;
      const sg  = ctx.createLinearGradient(362 - stw, 0, 362, 0);
      sg.addColorStop(0,                     '#d4900c');
      sg.addColorStop(Math.max(0, sp-0.22),  '#d4900c');
      sg.addColorStop(sp,                    '#fff8a0');
      sg.addColorStop(Math.min(1, sp+0.22),  '#c88010');
      sg.addColorStop(1,                     '#e0a020');
      ctx.shadowColor = '#ffcc00'; ctx.shadowBlur = 12;
      ctx.fillStyle = sg; ctx.fillText(scoreText, 362, nameY);
      ctx.shadowBlur = 0;
    } else if (row.rank === 2) {
      const scoreText = fmtScore(row.score);
      const stw = ctx.measureText(scoreText).width;
      const sg  = ctx.createLinearGradient(362 - stw, 0, 362, 0);
      sg.addColorStop(0, '#8aabb8'); sg.addColorStop(0.45, '#eef4fa'); sg.addColorStop(1, '#8aabb8');
      ctx.shadowColor = '#b8d0e8'; ctx.shadowBlur = 8;
      ctx.fillStyle = sg; ctx.fillText(scoreText, 362, nameY);
      ctx.shadowBlur = 0;
    } else if (row.rank === 3) {
      const scoreText = fmtScore(row.score);
      const stw = ctx.measureText(scoreText).width;
      const sg  = ctx.createLinearGradient(362 - stw, 0, 362, 0);
      sg.addColorStop(0, '#8a4a08'); sg.addColorStop(0.45, '#eea848'); sg.addColorStop(1, '#8a4a08');
      ctx.shadowColor = '#c06828'; ctx.shadowBlur = 8;
      ctx.fillStyle = sg; ctx.fillText(scoreText, 362, nameY);
      ctx.shadowBlur = 0;
    } else {
      ctx.fillStyle = isP ? '#c8c8ff' : '#66667a';
      ctx.fillText(fmtScore(row.score), 362, nameY);
    }

    // �ｭ� 嵓誤椈�ｸ (x=366)
    ctx.textAlign = 'left'; ctx.font = '13px sans-serif';
    ctx.fillText(countryFlag(row.country), 367, nameY);

    ctx.restore();
  });

  // ��款
  if (lbState.btnAlpha > 0) {
    ctx.save(); ctx.globalAlpha = lbState.btnAlpha; ctx.textAlign = 'center';
    if (lbState.viewOnly) {
      // �ｰ�ｴ �ｨ��: ��ｴ�ｰ �罷俺 ��款��
      drawBtn({x:160, y:660, w:160, h:44}, T.menu, false);
    } else {
      drawBtn(BTN_LB_RETRY, T.retry, false);
      drawBtn(BTN_LB_MENU,  T.menu,  false);
    }
    ctx.restore();
  }

  // �ｸ�� ���ｴ + �ｼ�們囈 �戦注��
  const shipAX = 52, shipAY = 630;
  if (bubble) {
    ctx.save(); ctx.translate(shipAX, shipAY); _drawShipShape(9); ctx.restore();
  }
  drawBubble(shipAX, shipAY - 9);
}

